{
  "window.title": "${activeEditorShort}${separator}Studienbuch${separator}${profileName}",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "eslint.rules.customizations": [{ "rule": "*", "severity": "warn" }],
  "eslint.runtime": "node",
  "eslint.workingDirectories": [
    { "pattern": "packages/*/" },
    { "pattern": "tooling/*/" }
  ],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.experimental.configFile": "./tooling/tailwind/web.ts",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.autoImportFileExcludePatterns": [
    "next/router.d.ts",
    "next/dist/client/router.d.ts"
  ],
  "typescript.referencesCodeLens.enabled": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "python.analysis.typeCheckingMode": "strict",
  "files.exclude": {
    ".venv": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.expo": true,
    "**/.dart_tool": true,
    "**/.idea": true
  },
  "workbench.editor.customLabels.patterns": {
    "**/page.tsx": "${dirname}.page",
    "**/index.{tsx,ts}": "${dirname}.index",
    "**/layout.tsx": "${dirname}.layout",
    "**/router.ts": "${dirname}.router",
    "**/*.ts": "${filename}"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "*"
  },
  "emmet.excludeLanguages": ["markdown", "typescriptreact"],
  "typescript.tsserver.watchOptions": {
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling",
    "watchFile": "useFsEventsOnParentDirectory",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["**/node_modules/**/*"]
  },
  "typescript.preferences.autoImportSpecifierExcludeRegexes": [
    "^drizzle-orm/mysql-core$",
    "^drizzle-orm/.+/columns(/.+)?$"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
  "files.autoSave": "afterDelay",
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[swift]": {
    "editor.defaultFormatter": "vknabel.vscode-apple-swift-format"
  }
}
