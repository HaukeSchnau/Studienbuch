{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/nextjs/",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Flutter App",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/apps/flutter/"
    },
    {
      "name": "Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "nr dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Flutter + Dev Server",
      "configurations": ["Flutter App", "Dev Server"]
    }
  ]
}
