{
  "extends": "@schnau/tsconfig/effect",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    // This list replaces the base's `plugins`, so it repeats the Effect entry. The patched tsrs
    // reports Effect's diagnostics through the lint already, and `namespaceImportPackages` feeds
    // `effecttsgo/prefer-namespace-import`.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "namespaceImportPackages": ["effect"]
      }
    ]
  }
}
