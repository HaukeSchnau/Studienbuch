    {
      "name": "sync_row_view",
      "definition": "select space, tbl, id, data from pending_row where data is not null\n      union all\n      select space, tbl, id, data from base_row as base\n      where not exists (\n        select 1 from pending_row as pending\n        where pending.space = base.space and pending.tbl = base.tbl and pending.id = base.id\n      )",
      "isExisting": false,
      "error": null,
      "entityType": "views"
