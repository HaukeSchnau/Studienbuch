    {
      "name": "Probe",
      "definition": "select space, id, data ->> '$.\"text\"' as \"text\", data -> '$.\"amount\"' as \"amount\", data ->> '$.\"flag\"' as \"flag\", data ->> '$.\"note\"' as \"note\", data -> '$.\"nested\"' as \"nested\", data ->> '$.\"group\"' as \"group\", data -> '$.\"key\"' as \"key\" from sync_row_view where tbl = 'Probe'",
