{
  "name": "@stu/app-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "APP_VARIANT=development expo start --ios",
    "dev:android": "APP_VARIANT=development expo start --android",
    "dev:e2e": "EXPO_PUBLIC_E2E_MODE=1 APP_VARIANT=development expo start --dev-client",
    "dev:ios": "APP_VARIANT=development expo start --ios",
    "android": "APP_VARIANT=production expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "lint": "oxlint --type-aware --type-check",
    "maestro:test": "maestro test --config ./maestro/config.yaml -e MAESTRO_APP_ID=${MAESTRO_APP_ID:-dev.schnau.studienbuch.dev} -e MAESTRO_APP_LINK=${MAESTRO_APP_LINK:-studienbuch://e2e/sync-lifecycle} ./maestro/flows",
    "maestro:test:lifecycle": "maestro test --config ./maestro/config.yaml -e MAESTRO_APP_ID=${MAESTRO_APP_ID:-dev.schnau.studienbuch.dev} -e MAESTRO_APP_LINK=${MAESTRO_APP_LINK:-studienbuch://e2e/sync-lifecycle} ./maestro/flows/sync-lifecycle-resume.yml ./maestro/flows/sync-lifecycle-replay.yml ./maestro/flows/sync-lifecycle-network-reconnect.yml ./maestro/flows/sync-lifecycle-sensitive-auth-reconnect.yml"
  },
  "dependencies": {
    "@dev-plugins/react-navigation": "^0.4.0",
    "@expo-google-fonts/nunito": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@groundswell/adapter-drizzle-sqlite": "^0.0.22",
    "@groundswell/adapter-sse-client": "^0.0.22",
    "@groundswell/core": "^0.0.22",
    "@groundswell/react": "^0.0.22",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "^2.9.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@schnau/effect-drizzle": "0.5.10",
    "@stu/expo-native": "workspace:*",
    "@stu/lib": "workspace:*",
    "@stu/student": "workspace:^",
    "@tanstack/react-form": "^1.19.2",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-store": "^0.7.0",
    "@trpc/client": "11.4.4",
    "@trpc/react-query": "11.4.4",
    "@trpc/server": "11.4.4",
    "babel-plugin-inline-import": "^3.0.0",
    "clsx": "^2.1.1",
