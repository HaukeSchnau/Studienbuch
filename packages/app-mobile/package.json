    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.12.1",
    "superjson": "2.2.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
