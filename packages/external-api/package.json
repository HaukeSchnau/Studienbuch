{
  "name": "@schnau/external-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "openapi --input https://ferien-api.de/v2/api-docs --output ./src/holidays/generated",
    "lint": "eslint",
    "test": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@linear/sdk": "^24.0.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "dayjs": "^1.11.11",
    "tough-cookie": "^4.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@schnau/eslint-config": "workspace:*",
    "@schnau/prettier-config": "workspace:*",
    "@schnau/tsconfig": "workspace:*",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^9.5.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "prettier": "@schnau/prettier-config"
}
