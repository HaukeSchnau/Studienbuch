{
  "name": "@stu/external-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev:internal": "tsc --watch",
    "format": "biome format",
    "generate": "openapi --input https://ferien-api.de/v2/api-docs --output ./src/holidays/generated",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@linear/sdk": "^38.0.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^9.24.0",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
