{
  "name": "@stu/external-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev:internal": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "openapi --input https://ferien-api.de/v2/api-docs --output ./src/holidays/generated",
    "lint": "eslint",
    "test": "vitest run",
    "test:dev": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@linear/sdk": "^27.0.0",
    "@t3-oss/env-nextjs": "^0.11.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "tough-cookie": "^4.1.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/prettier-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.0",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "catalog:",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^2.0.5"
  },
  "prettier": "@stu/prettier-config"
}
