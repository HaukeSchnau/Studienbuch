{
  "name": "@stu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "push": "pnpm db:push-sqlite",
    "db:push-sqlite": "drizzle-kit push --config drizzle.config.sqlite.ts",
    "dev:internal": "tsc --watch",
    "format": "biome format",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@stu/db": "workspace:*",
    "@stu/external-api": "workspace:*",
    "@stu/lib": "workspace:*",
    "@stu/lib-server": "workspace:*",
    "@stu/student": "workspace:^",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@trpc/server": "11.0.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "hono": "^4.7.4",
    "pg": "^8.14.1",
    "rabbitmq-stream-js-client": "^0.6.0",
    "superjson": "2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
