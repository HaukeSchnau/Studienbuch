{
  "name": "@schnau/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@schnau/auth": "workspace:*",
    "@schnau/db": "workspace:*",
    "@schnau/lib": "workspace:*",
    "@schnau/lib-server": "workspace:*",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@trpc/server": "11.0.0-next-beta.264",
    "dayjs": "^1.11.11",
    "superjson": "2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@schnau/eslint-config": "workspace:*",
    "@schnau/prettier-config": "workspace:*",
    "@schnau/tsconfig": "workspace:*",
    "eslint": "^9.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "prettier": "@schnau/prettier-config"
}
