{
  "name": "@schnau/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev:internal": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@schnau/auth": "workspace:*",
    "@schnau/db": "workspace:*",
    "@schnau/external-api": "workspace:*",
    "@schnau/lib": "workspace:*",
    "@schnau/lib-server": "workspace:*",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@trpc/server": "11.0.0-rc.449",
    "dayjs": "^1.11.11",
    "drizzle-zod": "^0.5.1",
    "superjson": "2.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@schnau/eslint-config": "workspace:*",
    "@schnau/prettier-config": "workspace:*",
    "@schnau/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@schnau/prettier-config"
}
