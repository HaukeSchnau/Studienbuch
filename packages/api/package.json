{
  "name": "@stu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev:internal": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@stu/db": "workspace:*",
    "@stu/external-api": "workspace:*",
    "@stu/lib": "workspace:*",
    "@stu/lib-server": "workspace:*",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@trpc/server": "^11.0.0-rc.477",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "drizzle-zod": "^0.5.1",
    "superjson": "2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/prettier-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "prettier": "@stu/prettier-config"
}
