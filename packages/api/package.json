{
  "name": "@stu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsx watch src/bin/http.ts",
    "push": "pnpm db:push-sqlite",
    "db:push-sqlite": "drizzle-kit push --config drizzle.config.sqlite.ts",
    "dev:internal": "tsc --watch",
    "format": "biome format",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1",
    "@axiomhq/pino": "^1.3.1",
    "@hono/node-server": "^1.14.1",
    "@hono/trpc-server": "^0.3.4",
    "@stu/db": "workspace:*",
    "@stu/lib": "workspace:*",
    "@stu/lib-server": "workspace:*",
    "@stu/student": "workspace:^",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@trpc/server": "11.0.3",
    "aws-sdk": "^2.1692.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "hono": "^4.7.7",
    "mock-aws-s3": "^4.0.2",
    "nock": "^14.0.3",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pulsar-client": "1.13.1",
    "superjson": "2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "bun-plugin-pino": "^1.4.0",
    "eslint": "^9.24.0",
    "tsx": "4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
