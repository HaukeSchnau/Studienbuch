{
  "name": "@stu/student",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/src/schema/index.d.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev:internal": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@stu/lib": "workspace:*",
    "@t3-oss/env-core": "^0.12.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.40.0",
    "drizzle-zod": "^0.7.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/prettier-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "prettier": "@stu/prettier-config"
}
