generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-1.1.x"]
}

generator zod {
    provider          = "zod-prisma-types"
    output            = "./zod"
    useMultipleFiles  = true
    useTypeAssertions = true
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_PRISMA_URL")
}
