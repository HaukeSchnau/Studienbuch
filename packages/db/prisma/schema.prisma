//
// Autogenerated by `prisma-import`
// Any modifications will be overwritten on subsequent runs.
//

//
// config.prisma
//

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

generator zod {
  provider          = "zod-prisma-types"
  output            = "./zod"
  useMultipleFiles  = true
  useTypeAssertions = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PRISMA_URL")
}

//
// auth.prisma
//

model LicenseKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  expiresAt   DateTime?
  isSuperKey  Boolean   @default(false)

  activatedBy   User? @relation(fields: [activatedById], references: [id])
  activatedById Int?
}

model User {
  id               Int       @id @default(autoincrement())
  email            String?
  name             String
  passwordHash     String?
  title            String?
  abbrv            String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  teacherInCourses Course[]  @relation("teacher")
  notificationKey  String?

  role        StaticRole?
  roles       Role[]
  permissions PermissionOnUser[]
  isSuperUser Boolean            @default(false)

  substituteIn Substitution[] @relation("substitute")
  absences     Absence[]
  tasks        Task[]
  grades       Grade[]
  licenseKeys  LicenseKey[]
  courses      Course[]       @relation("students")
}

model Session {
  token   String   @id
  expires DateTime

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StaticRole {
  TEACHER
  STUDENT
}

model Role {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  users       User[]
  permissions PermissionOnRole[]

  defaultScope Json?
}

model PermissionOnRole {
  permission Permission
  role       Role       @relation(fields: [roleId], references: [id])
  roleId     Int

  scope Json?

  @@id([permission, roleId])
}

model PermissionOnUser {
  permission Permission
  user       User       @relation(fields: [userId], references: [id])
  userId     Int

  scope Json?

  @@id([permission, userId])
}

enum Permission {
  EDIT_INFO_PAGES

  EDIT_USERS

  EDIT_COURSES
  EDIT_YEARS
  EDIT_CLASSES
  EDIT_SCHOOLS

  VIEW_LOGS
}

//
// features.prisma
//

model Absence {
  id     String   @id @default(cuid())
  date   DateTime
  reason String

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  student   User @relation(fields: [studentId], references: [id])
  studentId Int

  teacherSignature String?
  parentSignature  String?
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  dueDate     DateTime

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  owner   User @relation(fields: [ownerId], references: [id])
  ownerId Int

  images String[]

  done Boolean @default(false)
}

model Grade {
  id               String    @id @default(cuid())
  date             DateTime
  result           Decimal
  type             GradeType
  teacherSignature String?
  parentSignature  String?

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  student   User @relation(fields: [studentId], references: [id])
  studentId Int
}

enum GradeType {
  WRITTEN
  ORAL
  MASTER
}

//
// school.prisma
//

model School {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  image String
  theme Json

  years     Year[]
  semesters Semester[]
}

model Year {
  id             Int      @id @default(autoincrement())
  startYear      Int
  graduationYear Int
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  classes Class[]

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  @@unique([startYear, schoolId], name: "yearIdentifier")
}

enum SemesterType {
  SUMMER
  WINTER
}

model Semester {
  id   String       @id @default(cuid())
  year Int
  type SemesterType

  name  String
  start DateTime
  end   DateTime

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  courses Course[]
}

model Class {
  id               Int      @id @default(autoincrement())
  identifierInYear String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  courses Course[]

  year   Year @relation(fields: [yearId], references: [id])
  yearId Int

  @@unique([identifierInYear, yearId], name: "classIdentifier")
}

model Course {
  id          Int      @id @default(autoincrement())
  courseId    String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  room        String?
  isChoosable Boolean  @default(false)

  // TODO: Make the semester non-optional
  semester   Semester? @relation(fields: [semesterId], references: [id])
  semesterId String?

  teacher   User @relation(name: "teacher", fields: [teacherId], references: [id])
  teacherId Int

  times CourseTime[]

  // TODO: A course can be taught in multiple years (e.g. a course that is taught in 12th grade and 13th grade)
  class   Class @relation(fields: [classId], references: [id])
  classId Int

  substitutions Substitution[]
  subscriptions CourseSubscription[]
  absences      Absence[]
  tasks         Task[]
  grades        Grade[]
  students      User[]               @relation(name: "students")

  @@unique([courseId, classId], name: "courseIdentifier")
}

model CourseTime {
  id        Int             @id @default(autoincrement())
  weekday   Int
  start     Int // time of day in minutes since midnight
  duration  Int
  weeks     CourseTimeWeeks @default(BOTH)
  course    Course?         @relation(fields: [courseId], references: [id])
  courseId  Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
}

enum CourseTimeWeeks {
  EVEN
  ODD
  BOTH
}

// DEPRECATED
model CourseSubscription {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  messagingToken String

  @@unique([courseId, messagingToken], name: "courseSubscriptionIdentifier")
}

//
// substitution.prisma
//

model Substitution {
  id          Int      @id @default(autoincrement())
  date        DateTime
  lessonStart Int
  lessonEnd   Int

  substitute   User? @relation("substitute", fields: [substituteId], references: [id])
  substituteId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  room String?

  type SubstitutionType?

  @@unique([date, lessonStart, courseId], name: "substitutionIdentifier")
}

enum SubstitutionType {
  FREISETZUNG
  VERTRETUNG
  BETREUUNG
  ENTFALL
  TROTZ_ABSENZ
}
