// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

generator zod {
  provider          = "zod-prisma-types"
  output            = "./zod"
  useMultipleFiles  = true
  useTypeAssertions = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PRISMA_URL")
}

// USERS & AUTHENTICATION

model LicenseKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  expiresAt   DateTime?
  isSuperKey  Boolean   @default(false)
}

model User {
  id               Int                @id @default(autoincrement())
  email            String?
  name             String
  passwordHash     String?
  title            String?
  abbrv            String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  teacherInCourses Course[]
  role             StaticRole?
  roles            Role[]
  permissions      PermissionOnUser[]
  isSuperUser      Boolean            @default(false)

  substituteIn Substitution[]     @relation("substitute")
}

model Session {
  token   String   @id
  expires DateTime

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StaticRole {
  TEACHER
  STUDENT
}

model Role {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  users       User[]
  permissions PermissionOnRole[]

  defaultScope Json?
}

model PermissionOnRole {
  permission Permission
  role       Role       @relation(fields: [roleId], references: [id])
  roleId     Int

  scope Json?

  @@id([permission, roleId])
}

model PermissionOnUser {
  permission Permission
  user       User       @relation(fields: [userId], references: [id])
  userId     Int

  scope Json?

  @@id([permission, userId])
}

enum Permission {
  EDIT_INFO_PAGES

  EDIT_USERS

  EDIT_COURSES
  EDIT_YEARS
  EDIT_CLASSES
  EDIT_SCHOOLS

  VIEW_LOGS
}

// COURSES

model CourseTime {
  id        Int             @id @default(autoincrement())
  weekday   Int
  start     Int // time of day in minutes since midnight
  duration  Int
  weeks     CourseTimeWeeks @default(BOTH)
  course    Course?         @relation(fields: [courseId], references: [id])
  courseId  Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
}

enum CourseTimeWeeks {
  EVEN
  ODD
  BOTH
}

model Course {
  id          Int      @id @default(autoincrement())
  courseId    String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  room        String?
  isChoosable Boolean  @default(false)

  teacher   User @relation(fields: [teacherId], references: [id])
  teacherId Int

  times CourseTime[]

  // TODO: The relation is currently denormalized since the year is also stored in the class
  // Also, a course can be taught in multiple years (e.g. a course that is taught in 12th grade and 13th grade)
  // This should be normalized
  class   Class @relation(fields: [classId], references: [id])
  classId Int

  year   Year @relation(fields: [yearId], references: [id])
  yearId Int

  substitutions Substitution[]
  subscriptions CourseSubscription[]

  @@unique([courseId, classId, yearId], name: "courseIdentifier")
}

model Class {
  id               Int      @id @default(autoincrement())
  identifierInYear String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  courses Course[]

  year   Year @relation(fields: [yearId], references: [id])
  yearId Int

  @@unique([identifierInYear, yearId], name: "classIdentifier")
}

model Year {
  id             Int      @id @default(autoincrement())
  startYear      Int
  graduationYear Int
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  classes  Class[]
  courses  Course[]
  school   School   @relation(fields: [schoolId], references: [id])
  schoolId Int

  @@unique([startYear, schoolId], name: "yearIdentifier")
}

model Substitution {
  id          Int      @id @default(autoincrement())
  date        DateTime
  lessonStart Int
  lessonEnd   Int

  substitute   User? @relation("substitute", fields: [substituteId], references: [id])
  substituteId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  room String?

  type SubstitutionType?

  @@unique([date, lessonStart, courseId], name: "substitutionIdentifier")
}

enum SubstitutionType {
  FREISETZUNG
  VERTRETUNG
  BETREUUNG
  ENTFALL
  TROTZ_ABSENZ
}

model CourseSubscription {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  messagingToken String

  @@unique([courseId, messagingToken], name: "courseSubscriptionIdentifier")
}

model School {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  image String
  theme Json

  years Year[]
}
