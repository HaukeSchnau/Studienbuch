{
  "name": "@stu/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev:internal": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "push": "drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.11.0",
    "dayjs": "^1.11.12",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.5.1",
    "pg": "^8.12.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stu/eslint-config": "workspace:*",
    "@stu/prettier-config": "workspace:*",
    "@stu/tsconfig": "workspace:*",
    "@types/pg": "^8.11.6",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.24.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@stu/prettier-config"
}
