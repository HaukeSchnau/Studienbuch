{
  "name": "@schnau/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint src",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "db:generate": "prisma generate",
    "push": "prisma db push --skip-generate",
    "push-delete": "prisma db push --skip-generate --force-reset --accept-data-loss",
    "studio": "prisma studio --port 5556",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "@t3-oss/env-nextjs": "^0.9.2",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@schnau/eslint-config": "workspace:^0.2.0",
    "@schnau/prettier-config": "workspace:^0.1.0",
    "@schnau/tsconfig": "workspace:^0.1.0",
    "dotenv-cli": "^7.4.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.11.0",
    "typescript": "^5.4.2",
    "zod-prisma-types": "^3.1.6"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@schnau/eslint-config/base"
    ]
  },
  "prettier": "@schnau/prettier-config"
}
