{
  "name": "@schnau/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "db:generate": "prisma-import --schemas=\"prisma/schema/*\" --output prisma/schema.prisma --force && prisma generate",
    "deployment": "pnpm db:generate && prisma migrate deploy",
    "migrate": "pnpm db:generate && prisma migrate dev",
    "push": "prisma db push --skip-generate",
    "push-delete": "prisma db push --skip-generate --force-reset --accept-data-loss",
    "studio": "prisma studio --port 5556",
    "typecheck": "tsc --noEmit false"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "dayjs": "^1.11.11"
  },
  "devDependencies": {
    "@schnau/eslint-config": "workspace:*",
    "@schnau/prettier-config": "workspace:*",
    "@schnau/tsconfig": "workspace:*",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.2.0",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0",
    "prisma-import": "^1.0.5",
    "typescript": "^5.4.5",
    "zod-prisma-types": "^3.1.8"
  },
  "prettier": "@schnau/prettier-config"
}
