{
  "name": "@acme/db",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{mjs,ts,md,json}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:push-delete": "prisma db push --skip-generate --force-reset --accept-data-loss",
    "studio": "prisma studio --port 5556",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.3.1"
  },
  "devDependencies": {
    "@acme/eslint-config": "^0.2.0",
    "@acme/prettier-config": "^0.1.0",
    "@acme/tsconfig": "^0.1.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "prisma": "^5.3.1",
    "typescript": "^5.2.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@acme/eslint-config/base"
    ]
  },
  "prettier": "@acme/prettier-config"
}
