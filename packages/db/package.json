{
  "name": "@schnau/db",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint . ",
    "format": "prettier --check \"**/*.{mjs,ts,md,json}\"",
    "db:generate": "prisma generate",
    "push": "prisma db push --skip-generate",
    "push-delete": "prisma db push --skip-generate --force-reset --accept-data-loss",
    "studio": "prisma studio --port 5556",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1"
  },
  "devDependencies": {
    "@schnau/eslint-config": "^0.2.0",
    "@schnau/prettier-config": "^0.1.0",
    "@schnau/tsconfig": "^0.1.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "prisma": "^5.8.1",
    "typescript": "^5.3.3",
    "zod-prisma": "^0.5.4"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@schnau/eslint-config/base"
    ]
  },
  "prettier": "@schnau/prettier-config"
}
