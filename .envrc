use flake

dotenv_if_exists .env
dotenv_if_exists .env.secrets

export NODE_ENV=${NODE_ENV:-development}
export MANAGEMENT_DATABASE_URL=${MANAGEMENT_DATABASE_URL:-postgresql://stu:stu@localhost:5432/stu}
export LEGACY_DATABASE_URL=${LEGACY_DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/postgres}
export RABBITMQ_HOST=${RABBITMQ_HOST:-localhost}
export PULSAR_URL=${PULSAR_URL:-rabbitmq-stream://localhost:5552}
export API_PORT=${API_PORT:-3001}
export NEXT_PUBLIC_DEPLOYMENT_ENV=${NEXT_PUBLIC_DEPLOYMENT_ENV:-dev}
export CACHE_DIR=${CACHE_DIR:-./cache}
