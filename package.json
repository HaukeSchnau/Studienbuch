{
  "name": "studienbuch",
  "private": true,
  "engines": {
    "node": ">=20.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/expo-native-modules/example",
    "tooling/*"
  ],
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab",
  "scripts": {
    "build": "turbo run build",
    "build:internal": "turbo run --filter=\"./packages/*\" build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo push --ui=tui",
    "db:studio": "turbo -F @stu/db studio",
    "db:deploy": "pnpm -F db deployment",
    "dev": "turbo watch dev dev:internal",
    "dev:internal": "turbo watch dev:internal",
    "dev:next": "turbo watch dev dev:internal -F @stu/nextjs...",
    "dev:mobile": "turbo watch dev dev:internal -F @stu/rest... -F @stu/mobile... --ui=tui",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "vitest run",
    "test:dev": "vitest --ui --coverage",
    "typecheck": "turbo run typecheck --filter=!@stu/nextjs",
    "ci": "turbo run format lint typecheck",
    "ci:fix": "run-s format:fix lint:fix"
  },
  "devDependencies": {
    "@stu/prettier-config": "workspace:*",
    "@turbo/gen": "^2.1.3",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "prettier": "@stu/prettier-config",
  "pnpm": {
    "patchedDependencies": {
      "drizzle-kit": "patches/drizzle-kit.patch"
    }
  }
}
