{
  "name": "studienbuch",
  "private": true,
  "workspaces": ["packages/*", "tooling/*"],
  "packageManager": "bun@1.2.15",
  "scripts": {
    "build": "turbo run build",
    "build:internal": "turbo run --filter=\"./packages/*\" build",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo push --ui=tui",
    "db:studio": "turbo -F @stu/db studio",
    "db:deploy": "pnpm -F db deployment",
    "dev": "turbo watch dev dev:internal",
    "dev:internal": "turbo watch dev:internal",
    "dev:next": "turbo watch dev dev:internal -F @stu/nextjs...",
    "dev:mobile": "turbo watch dev dev:internal -F @stu/api... -F @stu/app-mobile... --ui=tui",
    "dev:api": "turbo watch dev dev:internal -F @stu/api... --ui=tui",
    "dev:expo": "turbo watch dev dev:internal -F @stu/app-mobile... --ui=tui",
    "format": "turbo run format",
    "format:fix": "turbo run format -- --write",
    "lint": "turbo run lint -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "sherif",
    "postinstall": "bun lint:ws",
    "test": "vitest run",
    "test:dev": "vitest --ui --coverage",
    "typecheck": "turbo run typecheck --filter=!@stu/nextjs",
    "ci": "turbo run format lint typecheck",
    "ci:fix": "run-s format:fix lint:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@turbo/gen": "^2.5.0",
    "@types/bun": "^1.2.10",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "graphviz-cli": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "sherif": "^1.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "patchedDependencies": {
    "expo-module-scripts@4.0.5": "patches/expo-module-scripts@4.0.5.patch"
  }
}
