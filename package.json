{
  "name": "studienbuch",
  "private": true,
  "engines": {
    "node": ">=20.16.0"
  },
  "packageManager": "pnpm@9.8.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo -F @stu/db push",
    "db:studio": "turbo -F @stu/db studio",
    "db:deploy": "pnpm -F db deployment",
    "dev": "turbo watch dev dev:internal",
    "dev:internal": "turbo run dev:internal",
    "dev:next": "turbo watch dev dev:internal -F @stu/nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "DATABASE_URL=postgresql://stu_test:stu_test@localhost:5433/stu_test turbo run test",
    "test:dev": "DATABASE_URL=postgresql://stu_test:stu_test@localhost:5433/stu_test turbo run dev:internal test:dev",
    "typecheck": "turbo run typecheck",
    "ci": "turbo run format lint typecheck",
    "ci:fix": "run-s format:fix lint:fix"
  },
  "devDependencies": {
    "@stu/prettier-config": "workspace:*",
    "@turbo/gen": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "prettier": "catalog:",
    "turbo": "^2.0.12",
    "typescript": "catalog:"
  },
  "prettier": "@stu/prettier-config"
}
