{
  "name": "studienbuch",
  "private": true,
  "workspaces": [
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:internal": "turbo run --filter=\"./packages/*\" build",
    "checks:lint": "oxlint --type-aware --type-check",
    "checks:lint:ci": "oxlint --type-aware --type-check --deny-warnings --format github",
    "checks:lint:fix-safe": "oxlint --type-aware --type-check --fix",
    "checks:lint:fix-all": "oxlint --type-aware --type-check --fix --fix-suggestions --fix-dangerously",
    "checks:fmt": "oxfmt",
    "checks:fmt:ci": "oxfmt --check",
    "clean:workspaces": "turbo run clean",
    "db:push": "turbo push --ui=tui",
    "db:studio": "turbo -F @stu/db studio",
    "db:deploy": "pnpm -F db deployment",
    "dev": "turbo watch dev dev:internal",
    "dev:internal": "turbo watch dev:internal",
    "dev:next": "turbo watch dev dev:internal -F @stu/web...",
    "dev:mobile": "turbo watch dev dev:internal -F @stu/api... -F @stu/app-mobile... --ui=tui",
    "dev:api": "turbo watch dev dev:internal -F @stu/api... --ui=tui",
    "dev:expo": "turbo watch dev dev:internal -F @stu/app-mobile... --ui=tui",
    "format": "bun run checks:fmt",
    "format:check": "bun run checks:fmt:ci",
    "lint": "bun run checks:lint",
    "lint:fix": "bun run checks:lint:fix-safe",
    "lint:workspaces": "turbo run lint --filter=!@stu/web",
    "lint:ws": "sherif",
    "postinstall": "bun lint:ws",
    "test": "vitest run",
    "test:ci": "mkdir -p test-results && vitest run packages/api/src/sync.integration.test.ts --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:sync": "bun test packages/api/src/sync.integration.test.ts",
    "test:maestro:mobile": "bun --filter @stu/app-mobile maestro:test",
    "test:dev": "vitest --ui --coverage",
    "typecheck": "turbo run typecheck --filter=!@stu/web",
    "ci": "run-s checks:fmt:ci checks:lint:ci typecheck test:ci",
    "ci:fix": "run-s checks:fmt checks:lint:fix-safe"
  },
  "devDependencies": {
    "@effect/language-service": "^0.36.0",
    "@turbo/gen": "^2.5.6",
    "@types/bun": "^1.2.10",
    "@typescript/native-preview": "^7.0.0-dev.20250716.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "lefthook": "^1.12.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "oxlint-tsgolint": "^0.14.2",
    "sherif": "^1.5.0",
    "turbo": "^2.5.6",
    "vitest": "^3.1.1"
  },
  "packageManager": "bun@1.2.15",
  "patchedDependencies": {
    "expo-module-scripts@4.0.5": "patches/expo-module-scripts@4.0.5.patch"
  }
}
