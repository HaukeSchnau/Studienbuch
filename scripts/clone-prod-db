#!/bin/bash

set -eau
. .env

NODE_ENV="${NODE_ENV:-development}"

if [[ $(hostname) == *"server"* ]] || [[ "$NODE_ENV" == "production" ]]; then
    echo "This script is not intended to be run on the production server."
    exit 1
fi

dropdb studienbuch
createdb studienbuch
ssh studienbuch@stu.dev "pg_dump" | psql studienbuch
