      ],
      "required": true
    },
    "smtpUrl": {
      "description": "",
      "generate": null,
      "kind": "secret",
      "realizations": [
        "release"
      ],
      "required": true
    },
    "webUntisPassword": {
      "description": "",
      "generate": null,
      "kind": "secret",
      "realizations": [
        "development",
        "release"
      ],
      "required": true
    },
    "webUntisUsername": {
      "description": "",
      "generate": null,
      "kind": "secret",
      "realizations": [
        "development",
        "release"
      ],
      "required": true
