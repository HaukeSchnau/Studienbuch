{
  "$schema": "https://raw.githubusercontent.com/HaukeSchnau/nix-infra-modules/main/schemas/project-descriptor/v2.json",
  "schemaVersion": 2,
  "project": "studienbuch",
  "secrets": {
    "betterAuthSecret": {
      "description": "Secret used to sign Better Auth sessions"
    },
    "databaseUrl": {
      "description": "PostgreSQL connection URL used by the web runtime and migrations"
    }
  },
  "development": {
    "preparation": {
      "action": "prepare"
    },
    "workloads": {
      "web": {
        "action": "web",
        "secrets": ["betterAuthSecret", "databaseUrl"]
      },
      "mobile": {
        "action": "mobile"
      }
    },
    "endpoints": {
      "web": {},
      "mobile": {
        "health": {
          "paths": ["/status"]
        }
      }
    }
  },
  "release": {
    "action": "web",
    "health": {
      "paths": ["/api/health/live", "/api/health/ready"],
      "startupTimeoutSec": 60,
      "intervalSec": 2,
      "requestTimeoutSec": 2
    },
    "ingress": {
      "compression": true
    }
  }
}
