{
  "development": {
    "commands": {
      "console": {
        "action": "studienbuch:console",
        "dependsOn": [],
        "secrets": [
          "webUntisPassword",
          "webUntisUsername"
        ]
      }
    },
    "endpoints": {
      "mobile": {
        "health": {
          "intervalSec": 1,
          "paths": [
            "/status"
          ],
          "requestTimeoutSec": 15,
          "startupTimeoutSec": 60
        },
        "port": 8081,
        "protocol": "http",
        "publication": "preview",
        "workload": "mobile"
      },
      "web": {
        "health": {
          "intervalSec": 1,
          "paths": [
            "/api/health/ready"
          ],
          "requestTimeoutSec": 15,
          "startupTimeoutSec": 60
        },
        "port": 3000,
        "protocol": "http",
        "publication": "preview",
        "workload": "web"
      }
    },
    "preparation": {
      "action": "prepare",
      "secrets": [],
      "timeoutSec": 900
    },
    "providers": {
      "database": {
        "database": "postgres",
        "majorVersion": 17,
        "port": 5432,
        "user": "postgres",
        "workload": "database"
      }
    },
    "workloads": {
      "database": {
        "action": "database",
        "dependsOn": [],
        "kind": "service",
        "lifecycle": "on-demand",
        "secrets": []
      },
      "mobile": {
        "action": "mobile",
        "dependsOn": [],
        "kind": "service",
        "lifecycle": "on-demand",
        "secrets": []
      },
      "web": {
        "action": "web",
        "dependsOn": [],
        "kind": "service",
        "lifecycle": "on-demand",
        "secrets": [
          "betterAuthSecret"
        ]
      },
      "worker": {
        "action": "worker",
        "dependsOn": [],
        "kind": "service",
        "lifecycle": "background",
        "secrets": [
          "webUntisPassword",
          "webUntisUsername"
        ]
      }
    }
  },
  "environment": {
    "development": {
      "actions": {
        "mobile": {
          "EXPO_PACKAGER_PROXY_URL": {
            "endpoint": "mobile",
            "field": "url"
          },
          "STUDIENBUCH_MOBILE_CACHE": {
            "append": "mobile",
            "path": "cache"
          },
          "STUDIENBUCH_MOBILE_HOST": {
            "endpoint": "mobile",
            "field": "listen.host"
          },
          "STUDIENBUCH_MOBILE_PORT": {
            "endpoint": "mobile",
            "field": "listen.port"
          }
        },
        "studienbuch:console": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        },
        "web": {
          "BETTER_AUTH_SECRET": {
            "binding": "betterAuthSecret",
            "field": "value"
          },
          "STUDIENBUCH_EMAIL_FROM": {
            "parameter": "authEmailFrom"
          },
          "STUDIENBUCH_PASSKEY_RP_ID": {
            "parameter": "passkeyRpId"
          },
          "STUDIENBUCH_WEB_HOST": {
            "endpoint": "web",
            "field": "listen.host"
          },
          "STUDIENBUCH_WEB_HOST_NAMES": {
            "endpoint": "web",
            "field": "hostNames"
          },
          "STUDIENBUCH_WEB_PORT": {
            "endpoint": "web",
            "field": "listen.port"
          }
        },
        "worker": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        }
      },
      "common": {
        "BETTER_AUTH_URL": {
          "endpoint": "web",
          "field": "url"
        },
        "DATABASE_URL": {
          "binding": "database",
          "field": "url"
        },
        "EXPO_PUBLIC_API_URL": {
          "endpoint": "web",
          "field": "url"
        },
        "OTEL_EXPORTER_OTLP_ENDPOINT": {
          "parameter": "observabilityOtlpEndpoint"
        },
        "PGDATA": {
          "binding": "database",
          "field": "dataDirectory"
        },
        "PGDATABASE": {
          "binding": "database",
          "field": "database"
        },
        "PGHOST": {
          "binding": "database",
          "field": "host"
        },
        "PGPORT": {
          "binding": "database",
          "field": "port"
        },
        "PGUSER": {
          "binding": "database",
          "field": "user"
        },
        "STUDIENBUCH_INSTANCE_ID": {
          "instance": "id"
        },
        "STUDIENBUCH_OTEL_ENABLED": "true"
      }
    },
    "release": {
      "actions": {
        "console": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        },
        "web": {
          "BETTER_AUTH_SECRET": {
            "binding": "betterAuthSecret",
            "field": "value"
          },
          "HOST": {
            "endpoint": "web",
            "field": "listen.host"
          },
          "PORT": {
            "endpoint": "web",
            "field": "listen.port"
          },
          "STUDIENBUCH_EMAIL_FROM": {
            "parameter": "authEmailFrom"
          },
          "STUDIENBUCH_PASSKEY_RP_ID": {
            "parameter": "passkeyRpId"
          },
          "STUDIENBUCH_SMTP_URL_FILE": {
            "binding": "smtpUrl",
            "field": "file"
          }
        },
        "webuntis-course-rosters": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        },
        "webuntis-directory": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        },
        "webuntis-timetable-hot": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        },
        "webuntis-timetable-warm": {
          "WEBUNTIS_PASSWORD": {
            "binding": "webUntisPassword",
            "field": "value"
          },
          "WEBUNTIS_SCHOOL_LOGIN_NAME": {
            "parameter": "webUntisSchoolLoginName"
          },
          "WEBUNTIS_SCHOOL_NAME": {
            "parameter": "webUntisSchoolName"
          },
          "WEBUNTIS_SERVER_URL": {
            "parameter": "webUntisServerUrl"
          },
          "WEBUNTIS_TENANT_ID": {
            "parameter": "webUntisTenantId"
          },
          "WEBUNTIS_USERNAME": {
            "binding": "webUntisUsername",
            "field": "value"
          }
        }
      },
      "common": {
        "BETTER_AUTH_URL": {
          "endpoint": "web",
          "field": "url"
        },
        "DATABASE_URL": {
          "binding": "database",
          "field": "url"
        },
        "OTEL_EXPORTER_OTLP_ENDPOINT": {
          "parameter": "observabilityOtlpEndpoint"
        },
        "STUDIENBUCH_ENVIRONMENT": "production",
        "STUDIENBUCH_INSTANCE_ID": {
          "instance": "id"
        },
        "STUDIENBUCH_OTEL_ENABLED": "true"
      }
    }
  },
  "parameters": {
    "authEmailFrom": {
      "default": "Studienbuch <konto@studienbuch.app>",
      "description": "Sender shown on authentication email",
      "required": false,
      "type": "string"
    },
    "observabilityOtlpEndpoint": {
      "description": "OpenTelemetry Protocol HTTP endpoint selected by the runtime",
      "required": true,
      "type": "string"
    },
    "passkeyRpId": {
      "default": "studienbuch.app",
      "description": "WebAuthn relying-party ID shared by production origins",
      "required": false,
      "type": "string"
    },
    "webUntisSchoolLoginName": {
      "description": "Operational WebUntis school login name",
      "required": true,
      "type": "string"
    },
    "webUntisSchoolName": {
      "description": "Display name used to discover the WebUntis school",
      "required": true,
      "type": "string"
    },
    "webUntisServerUrl": {
      "description": "Pinned WebUntis server URL",
      "required": true,
      "type": "string"
    },
    "webUntisTenantId": {
      "description": "Pinned WebUntis tenant identity",
      "required": true,
      "type": "string"
    }
  },
  "project": "studienbuch",
  "release": {
    "action": "web",
    "activationExecutable": null,
    "backend": "service",
    "commands": {
      "console": {
        "action": "console",
        "secrets": [
          "webUntisUsername",
          "webUntisPassword"
        ]
      }
    },
    "executable": "project-release-runtime",
    "health": {
      "intervalSec": 2,
      "paths": [
        "/api/health/live",
        "/api/health/ready"
      ],
      "requestTimeoutSec": 2,
      "startupTimeoutSec": 60
    },
    "ingress": {
      "cacheRules": [],
      "compression": true,
      "redirects": [],
      "requestBodyMaxBytes": null,
      "responseHeaders": {},
      "streamCloseDelaySec": null
    },
    "maintenanceJobs": {
      "webuntis-course-rosters": {
        "action": "webuntis-course-rosters",
        "schedule": {
          "cadence": null,
          "calendar": "*-*-* 04:00:00",
          "interval": null
        },
        "secrets": [
          "webUntisUsername",
          "webUntisPassword"
        ]
      },
      "webuntis-directory": {
        "action": "webuntis-directory",
        "schedule": {
          "cadence": null,
          "calendar": "*-*-* 03:15:00",
          "interval": null
        },
        "secrets": [
          "webUntisUsername",
          "webUntisPassword"
        ]
      },
      "webuntis-timetable-hot": {
        "action": "webuntis-timetable-hot",
        "schedule": {
          "cadence": "fixed",
          "calendar": null,
          "interval": "10min"
        },
        "secrets": [
          "webUntisUsername",
          "webUntisPassword"
        ]
      },
      "webuntis-timetable-warm": {
        "action": "webuntis-timetable-warm",
        "schedule": {
          "cadence": "fixed",
          "calendar": null,
          "interval": "1h"
        },
        "secrets": [
          "webUntisUsername",
          "webUntisPassword"
        ]
      }
    },
    "ociAuxiliaries": {},
    "package": "projectRelease",
    "preDeployTasks": {
      "migrate": {
        "action": "migrate",
        "dependsOn": [],
        "failureMode": "fail",
        "secrets": [],
        "timeoutSec": 300
      }
    },
    "stateDirectories": []
  },
  "requirements": {
    "betterAuthSecret": {
      "description": "",
      "generate": {
        "bytes": 32
      },
      "kind": "secret",
