{
  "$schema": "https://raw.githubusercontent.com/HaukeSchnau/nix-infra-modules/main/schemas/project-descriptor/v3.json",
  "schemaVersion": 3,
  "project": "studienbuch",
  "secrets": {
    "betterAuthSecret": {
      "description": "Secret used to sign Better Auth sessions"
    },
    "smtpUrl": {
      "description": "SMTP connection URL used to deliver authentication email"
    },
    "webUntisUsername": {
      "description": "WebUntis account used for school data imports"
    },
    "webUntisPassword": {
      "description": "Password for the WebUntis import account"
    }
  },
  "parameters": {
    "databaseUrl": {
      "description": "PostgreSQL connection URL used by the Release runtime",
      "default": "postgresql:///studienbuch?host=/run/postgresql"
    },
    "authEmailFrom": {
      "description": "Sender shown on authentication email",
      "default": "Studienbuch <konto@studienbuch.app>"
    },
    "passkeyRpId": {
      "description": "WebAuthn relying-party ID shared by production origins",
      "default": "studienbuch.app"
    },
    "webUntisSchoolName": {
      "description": "Display name used to discover the WebUntis school",
      "default": "IGS Lilienthal"
    },
    "webUntisSchoolLoginName": {
      "description": "Operational WebUntis school login name",
      "default": "igs-lilienthal"
    },
    "webUntisServerUrl": {
      "description": "Pinned WebUntis server URL",
      "default": "https://igs-lilienthal.webuntis.com"
    },
    "webUntisTenantId": {
      "description": "Pinned WebUntis tenant identity",
      "default": "6603700"
    },
    "observabilityOtlpEndpoint": {
      "description": "OpenTelemetry Protocol HTTP endpoint selected by the runtime",
      "default": "http://127.0.0.1:4318"
    }
  },
  "development": {
    "preparation": {
      "action": "prepare"
    },
    "workloads": {
      "database": {
        "action": "database"
      },
      "migrate": {
        "action": "migrate",
        "kind": "task",
        "dependsOn": ["database"]
      },
      "web": {
        "action": "web",
        "dependsOn": ["migrate"],
        "secrets": ["betterAuthSecret"]
      },
      "mobile": {
        "action": "mobile"
      },
      "importer": {
        "action": "worker",
        "kind": "service",
        "lifecycle": "background",
        "dependsOn": ["migrate"],
        "secrets": ["webUntisUsername", "webUntisPassword"]
      }
    },
    "commands": {
      "console": {
        "action": "console",
        "dependsOn": ["migrate"],
        "secrets": ["webUntisUsername", "webUntisPassword"]
      }
    },
    "endpoints": {
      "database": {
        "protocol": "tcp",
        "workload": "database"
      },
      "web": {
        "health": {
          "paths": ["/api/health/ready"]
        }
      },
      "mobile": {
        "health": {
          "paths": ["/status"]
        }
      }
    }
  },
  "release": {
    "action": "web",
    "commands": {
      "console": {
        "action": "console",
        "secrets": ["webUntisUsername", "webUntisPassword"]
      }
    },
    "preDeployTasks": {
      "migrate": {
        "timeoutSec": 300
      }
    },
    "maintenanceJobs": {
      "webuntis-directory": {
        "secrets": ["webUntisUsername", "webUntisPassword"]
      },
      "webuntis-timetable-hot": {
        "secrets": ["webUntisUsername", "webUntisPassword"]
      },
      "webuntis-timetable-warm": {
        "secrets": ["webUntisUsername", "webUntisPassword"]
      },
      "webuntis-course-rosters": {
        "secrets": ["webUntisUsername", "webUntisPassword"]
      }
    },
    "health": {
      "paths": ["/api/health/live", "/api/health/ready"],
      "startupTimeoutSec": 60,
      "intervalSec": 2,
      "requestTimeoutSec": 2
    },
    "ingress": {
      "compression": true
    }
  }
}
