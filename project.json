{
  "$schema": "https://raw.githubusercontent.com/HaukeSchnau/nix-infra-modules/main/schemas/project-descriptor/v2.json",
  "schemaVersion": 2,
  "project": "studienbuch",
  "secrets": {
    "betterAuthSecret": {
      "description": "Secret used to sign Better Auth sessions"
    }
  },
  "parameters": {
    "databaseUrl": {
      "description": "PostgreSQL connection URL used by the Release runtime",
      "default": "postgresql:///studienbuch?host=/run/postgresql"
    }
  },
  "development": {
    "preparation": {
      "action": "prepare"
    },
    "workloads": {
      "database": {
        "action": "database"
      },
      "migrate": {
        "action": "migrate",
        "kind": "task",
        "dependsOn": ["database"]
      },
      "web": {
        "action": "web",
        "dependsOn": ["migrate"],
        "secrets": ["betterAuthSecret"]
      },
      "mobile": {
        "action": "mobile"
      }
    },
    "endpoints": {
      "database": {
        "protocol": "tcp",
        "workload": "database"
      },
      "web": {},
      "mobile": {
        "health": {
          "paths": ["/status"]
        }
      }
    }
  },
  "release": {
    "action": "web",
    "preDeployTasks": {
      "migrate": {
        "timeoutSec": 300
      }
    },
    "health": {
      "paths": ["/api/health/live", "/api/health/ready"],
      "startupTimeoutSec": 60,
      "intervalSec": 2,
      "requestTimeoutSec": 2
    },
    "ingress": {
      "compression": true
    }
  }
}
