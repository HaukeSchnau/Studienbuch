{
  "extends": ["../../tsconfig.json", "expo/tsconfig.base"],
  "compilerOptions": {
    // TODO: Enable once the mobile app and React Native dependencies use exact optional props.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@stu/core": ["../../packages/core/src/index.ts"],
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
