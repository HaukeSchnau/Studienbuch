{
  "extends": ["../../tsconfig.json", "expo/tsconfig.base"],
  "compilerOptions": {
    // One alias, not three. `@stu/core` is deliberately not mapped: pointing it at the root
    // barrel collapses the package's fifteen subpath exports, which ADR 0001 asks bundle-sensitive
    // mobile consumers not to do. The workspace link resolves it through package.json exports.
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
