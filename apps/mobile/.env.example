# Public URL of the Studienbuch web/server deployment, including scheme and port.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional. Crash reporting remains disabled when this is absent.
EXPO_PUBLIC_SENTRY_DSN=

# Optional override. Defaults to /api/observability/v1/telemetry on EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_TELEMETRY_ENDPOINT=
