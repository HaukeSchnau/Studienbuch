{
  "name": "@stu/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --ios",
    "dev:dev-client": "expo run:ios",
    "doctor": "vp dlx expo-doctor",
    "doctor:deps": "expo install --check",
    "generate:icons": "vp run --workspace-root generate:icons",
    "test": "vp test run --passWithNoTests",
    "build:dev": "vp dlx eas-cli build --platform ios --profile development --local",
    "build:dev:device": "vp dlx eas-cli build --platform ios --profile development --local",
    "build:dev:simulator": "vp dlx eas-cli build --platform ios --profile development-simulator --local",
    "build:prod": "vp dlx eas-cli build --platform ios --profile production --local",
    "build:prod:device": "vp dlx eas-cli build --platform ios --profile production-device --local",
    "update:preview": "vp dlx eas-cli update --channel preview",
    "update:production": "vp dlx eas-cli update --channel production",
    "update:production:rollout": "vp dlx eas-cli update --channel production --rollout-percentage 10",
    "update:rollback": "vp dlx eas-cli update:rollback --channel production",
    "updates:assets:verify": "node scripts/verify-update-assets.mjs",
    "updates:fingerprint": "vp run updates:fingerprint:ios && vp run updates:fingerprint:android",
    "updates:fingerprint:ios": "expo-updates fingerprint:generate --platform ios",
    "updates:fingerprint:android": "expo-updates fingerprint:generate --platform android",
    "observe:versions": "vp dlx eas-cli observe:versions",
    "observe:metrics": "vp dlx eas-cli observe:metrics-summary"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~57.0.10",
    "@stu/core": "workspace:*",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.12",
    "expo-checkbox": "~57.0.0",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-observe": "~57.0.12",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.9",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mask-input": "^1.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.18",
    "postcss": "^8.5.26",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:"
  }
}
