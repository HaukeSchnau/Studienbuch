DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studienbuch
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
# Development prints auth links to the web process. Production must use smtp.
STUDIENBUCH_AUTH_EMAIL_MODE=console
STUDIENBUCH_SMTP_URL=smtps://username:password@smtp.example.com:465
STUDIENBUCH_EMAIL_FROM=Studienbuch <no-reply@studienbuch.app>
# Set only for a production-compatible HTTPS origin. Development derives its own RP ID.
# STUDIENBUCH_PASSKEY_RP_ID=studienbuch.app

# Optional. Read by the server at runtime and handed to the browser through the root route loader,
# so changing one only needs a restart, never a rebuild.
# STUDIENBUCH_SENTRY_DSN=
