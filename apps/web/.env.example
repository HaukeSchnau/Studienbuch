DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studienbuch
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional. Read by the server at runtime and handed to the browser through the root route loader,
# so changing one only needs a restart, never a rebuild.
# STUDIENBUCH_SENTRY_DSN=
# STUDIENBUCH_POSTHOG_KEY=
# STUDIENBUCH_POSTHOG_HOST=https://eu.i.posthog.com
