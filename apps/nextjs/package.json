{
  "name": "@schnau/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 next lint",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@schnau/api": "^0.1.0",
    "@schnau/auth": "^0.1.0",
    "@schnau/common": "^0.1.0",
    "@schnau/db": "^0.1.0",
    "@t3-oss/env-nextjs": "^0.7.3",
    "@tanstack/react-query": "^5.17.19",
    "@tanstack/react-query-devtools": "^5.17.21",
    "@tanstack/react-query-next-experimental": "5.17.19",
    "@trpc/client": "^10.45.0",
    "@trpc/next": "^10.45.0",
    "@trpc/react-query": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "clsx": "^2.1.0",
    "immer": "^10.0.3",
    "next": "^14.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.49.3",
    "superjson": "2.2.1",
    "swagger-ui-react": "^5.11.0",
    "zod": "^3.22.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@schnau/eslint-config": "^0.2.0",
    "@schnau/prettier-config": "^0.1.0",
    "@schnau/tailwind-config": "^0.1.0",
    "@schnau/tsconfig": "^0.1.0",
    "@storybook/addon-essentials": "^7.6.10",
    "@storybook/addon-interactions": "^7.6.10",
    "@storybook/addon-links": "^7.6.10",
    "@storybook/blocks": "^7.6.10",
    "@storybook/nextjs": "^7.6.10",
    "@storybook/react": "^7.6.10",
    "@storybook/testing-library": "^0.2.2",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/swagger-ui-react": "^4.18.3",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-storybook": "^0.6.15",
    "prettier": "^3.2.4",
    "storybook": "^7.6.10",
    "tailwindcss": "3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@schnau/eslint-config/base",
      "@schnau/eslint-config/nextjs",
      "@schnau/eslint-config/react",
      "plugin:storybook/recommended"
    ]
  },
  "prettier": "@schnau/prettier-config"
}
