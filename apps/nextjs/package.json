{
  "name": "@schnau/nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 next lint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@schnau/api": "workspace:^0.1.0",
    "@schnau/auth": "workspace:^0.1.0",
    "@schnau/db": "workspace:^0.1.0",
    "@schnau/lib": "workspace:^0.1.0",
    "@schnau/lib-server": "workspace:^0.1.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-form": "^0.19.4",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-table": "^8.16.0",
    "@tanstack/zod-form-adapter": "^0.19.4",
    "@trpc/client": "11.0.0-next-beta.264",
    "@trpc/react-query": "11.0.0-next-beta.264",
    "@trpc/server": "11.0.0-next-beta.264",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "next": "^14.2.3",
    "next-axiom": "^1.1.1",
    "next-bundle-analyzer": "^0.6.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-loading-indicators": "^0.2.3",
    "superjson": "2.2.1",
    "use-immer": "^0.9.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.3",
    "@schnau/eslint-config": "workspace:^0.2.0",
    "@schnau/prettier-config": "workspace:^0.1.0",
    "@schnau/tailwind-config": "workspace:^0.1.0",
    "@schnau/tsconfig": "workspace:^0.1.0",
    "@storybook/addon-essentials": "^8.0.9",
    "@storybook/addon-interactions": "^8.0.9",
    "@storybook/addon-links": "^8.0.9",
    "@storybook/blocks": "^8.0.9",
    "@storybook/nextjs": "^8.0.9",
    "@storybook/react": "^8.0.9",
    "@storybook/testing-library": "^0.2.2",
    "@tanstack/react-query-devtools": "^5.32.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "dotenv-cli": "^7.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-storybook": "^0.8.0",
    "jiti": "^1.21.0",
    "prettier": "^3.2.5",
    "storybook": "^8.0.9",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@schnau/eslint-config/base",
      "@schnau/eslint-config/nextjs",
      "@schnau/eslint-config/react",
      "plugin:storybook/recommended"
    ]
  },
  "prettier": "@schnau/prettier-config"
}
