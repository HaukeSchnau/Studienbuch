{
  "name": "@schnau/expo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean": "git clean -xdf .expo .turbo node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "storybook-generate": "sb-rn-get-stories",
    "storybook-watch": "sb-rn-watcher"
  },
  "dependencies": {
    "@expo/metro-config": "^0.17.4",
    "@shopify/flash-list": "1.6.3",
    "@tanstack/react-query": "^5.22.2",
    "@trpc/client": "^10.45.1",
    "@trpc/react-query": "^10.45.1",
    "@trpc/server": "^10.45.1",
    "expo": "^50.0.7",
    "expo-constants": "~15.4.5",
    "expo-linking": "~6.2.2",
    "expo-router": "3.4.7",
    "expo-splash-screen": "~0.26.4",
    "expo-status-bar": "~1.11.1",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.4",
    "react-native-gesture-handler": "~2.15.0",
    "react-native-reanimated": "~3.7.1",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "^14.1.0",
    "superjson": "2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/runtime": "^7.23.9",
    "@expo/config-plugins": "^7.8.4",
    "@react-native-async-storage/async-storage": "^1.22.1",
    "@react-native-community/datetimepicker": "^7.6.2",
    "@react-native-community/slider": "^4.5.0",
    "@schnau/api": "0.1.0",
    "@schnau/eslint-config": "0.2.0",
    "@schnau/prettier-config": "0.1.0",
    "@schnau/tailwind-config": "0.1.0",
    "@schnau/tsconfig": "0.1.0",
    "@storybook/addon-actions": "^7.6.17",
    "@storybook/addon-controls": "^7.6.17",
    "@storybook/addon-ondevice-actions": "^7.6.15",
    "@storybook/addon-ondevice-controls": "^7.6.15",
    "@storybook/react-native": "^7.6.15",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^18.2.57",
    "babel-loader": "^9.1.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "react-native-safe-area-context": "4.9.0",
    "tailwindcss": "3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@schnau/eslint-config/base",
      "@schnau/eslint-config/react"
    ],
    "ignorePatterns": [
      "expo-plugins/**"
    ]
  },
  "prettier": "@schnau/prettier-config"
}
