{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.cache/**",
    "**/generated/**",
    "**/*.gen.ts",
    "**/storybook.requires.ts",
    "packages/expo-native-example/android/**",
    "packages/expo-native-example/ios/**",
    "packages/app-mobile/android/**",
    "packages/app-mobile/ios/**",
    "bun.lock",
    "AGENTS.md"
  ]
}
